<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- Read connectivity to show the offline banner; INTERNET for Supabase sync. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- Runtime permission, Android 13+; step 1 of the onboarding wizard. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Location: foreground and background are requested in SEPARATE wizard steps —
       on Android 11+ a combined request is silently ignored by the system. -->
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
  <!-- Block screen over the offending app (M5). -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <!-- Enforcement must survive battery optimisation; requested with prominent disclosure. -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- Location reporting runs in a foreground service (Android 14+ requires the typed
       permission to match foregroundServiceType="location"). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
  <!-- App-op permission granted via Settings → Usage access; the wizard deep-links there.
       Reads the same system statistics Digital Wellbeing shows. -->
  <uses-permission
    android:name="android.permission.PACKAGE_USAGE_STATS"
    tools:ignore="ProtectedPermissions" />
  <!-- Only for scanning the pairing QR; frames are analyzed in memory, never stored.
       Not required hardware — the 6-digit manual code works without a camera. -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature
    android:name="android.hardware.camera.any"
    android:required="false" />
  <!-- Parental control needs the FULL app list: resolving names/icons of any app the
       child uses (M4 screen time) and blocking arbitrary apps (M5). Play Console
       justification: core parental-control functionality; usage stays this narrow. -->
  <uses-permission
    android:name="android.permission.QUERY_ALL_PACKAGES"
    tools:ignore="QueryAllPackagesPermission" />

  <!-- allowBackup=false: на этом устройстве будут TOTP-секрет и правила;
       автобэкап не должен их выносить с устройства. -->
  <application
    android:name=".KiteChildApp"
    android:allowBackup="false"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:supportsRtl="true"
    android:theme="@style/Theme.Kite">

    <activity
      android:name=".MainActivity"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- Offline removal-code entry (M6). Launched from the uninstall-guard overlay; not
         exported — nothing outside the app should start it. excludeFromRecents so it does
         not linger in the task switcher after authorising. -->
    <activity
      android:name=".removal.RemovalActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:theme="@style/Theme.Kite" />

    <activity
      android:name=".removal.ExtraTimeActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:theme="@style/Theme.Kite" />

    <!-- Location reporting (M7). foregroundServiceType=location is mandatory on Android 14+;
         its notification (SERVICE channel, MIN importance) cannot be hidden. -->
    <service
      android:name=".location.LocationService"
      android:exported="false"
      android:foregroundServiceType="location" />

    <!-- Parental-control accessibility service (Play policy permits this use with parent
         consent). Deliberately NOT flagged isAccessibilityTool — that flag is only for
         apps serving users with disabilities. M2: exists so the wizard can enable it;
         foreground-app detection logic arrives in M5. -->
    <service
      android:name=".service.KiteAccessibilityService"
      android:exported="false"
      android:label="@string/accessibility_service_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/accessibility_service_config" />
    </service>

    <!-- Tier-1 uninstall protection (M6): an active admin makes Android refuse plain
         uninstall. Honest limitation: Safe Mode or a second user profile bypasses it. -->
    <receiver
      android:name=".admin.KiteDeviceAdminReceiver"
      android:exported="true"
      android:permission="android.permission.BIND_DEVICE_ADMIN">
      <intent-filter>
        <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
      </intent-filter>
      <meta-data
        android:name="android.app.device_admin"
        android:resource="@xml/device_admin_policies" />
    </receiver>

    <receiver android:name=".apps.PackageChangeReceiver" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.PACKAGE_ADDED" />
        <action android:name="android.intent.action.PACKAGE_REMOVED" />
        <action android:name="android.intent.action.PACKAGE_FULLY_REMOVED" />
        <data android:scheme="package" />
      </intent-filter>
    </receiver>

    <receiver android:name=".boot.BootReceiver" android:exported="true" android:directBootAware="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.QUICKBOOT_POWERON" />
      </intent-filter>
    </receiver>

    <!-- Hands a downloaded update APK to the package installer (hms / direct builds). -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.updates"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/update_paths" />
    </provider>

  </application>

</manifest>
