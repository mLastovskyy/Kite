<?xml version="1.0" encoding="utf-8"?>
<!-- force-lock backs the instant remote lock (M5). Uninstall refusal comes from the admin
     being active at all, not from a policy. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-policies>
    <force-lock />
  </uses-policies>
</device-admin>
